# Postgres (Vercel Postgres / Neon). Vercel setzt das beim Verbinden automatisch.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Gemeinsames Geheimnis zwischen Haupt-App und Portal. MUSS in beiden Apps
# identisch sein. Schützt die Sync-Endpunkte (/api/sync/*).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SYNC_SECRET="BITTE_LANGEN_ZUFALLSWERT_EINTRAGEN"

# Schlüssel zum Signieren des Verkäufer-PIN-Cookies (nur im Portal genutzt).
# Fällt auf SYNC_SECRET zurück, wenn nicht gesetzt.
PORTAL_SESSION_SECRET="BITTE_LANGEN_ZUFALLSWERT_EINTRAGEN"
