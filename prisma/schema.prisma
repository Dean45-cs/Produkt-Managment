generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  productGroups ProductGroup[]
}

model Location {
  id               String            @id @default(cuid())
  name             String            @unique
  type             String            @default("WAREHOUSE")
  address          String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inventory        Inventory[]
  stockAdjustments StockAdjustment[]
  deliveryItems    DeliveryItem[]
  returnItems      ReturnItem[]
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  // Rollen: derselbe Kontakt kann Verkäufer (Außendienst) und/oder Lieferant
  // (Großhändler, bei dem eingekauft wird) sein.
  isSeller       Boolean         @default(true)
  isWholesaler   Boolean         @default(false)
  // Nach wie vielen Tagen erwartest du von diesem Verkäufer die Abrechnung?
  // null → globaler Standardwert (siehe DEFAULT_SETTLE_DAYS).
  expectedSettleDays Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deliveries     Delivery[]
  purchaseOrders PurchaseOrder[]
}

/// Eine "Art" von Ware (z.B. Kaffee). Darunter hängen die einzelnen Sorten,
/// die weiterhin ganz normale Produkte mit eigenem Bestand und Preis sind.
model ProductGroup {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  sku                String              @unique
  description        String?
  imageUrl           String?
  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [id])
  groupId            String?
  group              ProductGroup?       @relation(fields: [groupId], references: [id])
  /// Bezeichnung der Sorte innerhalb der Art (z.B. "Hausmischung").
  variantName        String?
  unit               String              @default("Stück")
  purchasePriceCt    Int                 @default(0)
  minStockLevel      Int                 @default(0)
  reorderPoint       Int                 @default(0)
  reorderQty         Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventory          Inventory[]
  stockAdjustments   StockAdjustment[]
  deliveryItems      DeliveryItem[]
  settlementItems    SettlementItem[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  reviews            Review[]
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating       Int // 1-5 Sterne (Kundenzufriedenheit)
  comment      String?
  customerName String?
  createdAt    DateTime @default(now())

  @@index([productId])
}

model Inventory {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
}

model StockAdjustment {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  delta      Int
  reason     String
  note       String?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
}

model Delivery {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  status       String         @default("PENDING")
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        DeliveryItem[]
  settlements  Settlement[]
  returns      Return[]
}

model DeliveryItem {
  id              String   @id @default(cuid())
  deliveryId      String
  delivery        Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  locationId      String
  location        Location @relation(fields: [locationId], references: [id])
  quantitySent    Int
  expectedPriceCt Int?
  batchNumber     String?

  @@unique([deliveryId, productId])
}

model Settlement {
  id            String           @id @default(cuid())
  deliveryId    String
  delivery      Delivery         @relation(fields: [deliveryId], references: [id])
  settledAt     DateTime         @default(now())
  totalAmountCt Int
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         SettlementItem[]
  bookEntries   BookEntry[]

  @@index([deliveryId])
}

model SettlementItem {
  id            String     @id @default(cuid())
  settlementId  String
  settlement    Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  quantitySold  Int
  totalAmountCt Int

  @@unique([settlementId, productId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  status      String              @default("DRAFT")
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
  bookEntries BookEntry[]
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitPriceCt      Int           @default(0)

  @@unique([purchaseOrderId, productId])
}

model Return {
  id         String       @id @default(cuid())
  deliveryId String?
  delivery   Delivery?    @relation(fields: [deliveryId], references: [id])
  returnDate DateTime     @default(now())
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  items      ReturnItem[]
}

model ReturnItem {
  id               String   @id @default(cuid())
  returnId         String
  return           Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  quantityReturned Int
}

/// Ein Geldtopf: die Kasse (Bargeld, das reinkommt) oder die Bank
/// (Rücklage, die für die nächste Bestellung nicht angerührt wird).
/// Der Saldo wird nicht gespeichert, sondern immer aus den Buchungen summiert.
model Account {
  id        String      @id @default(cuid())
  name      String      @unique
  kind      String      @default("CASH") // CASH | BANK
  /// true = "nicht anrühren", Rücklage für den nächsten Einkauf.
  isReserve Boolean     @default(false)
  notes     String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  entries   BookEntry[]
}

/// Eine einzelne Geldbewegung auf einem Konto. Wird ausschließlich von Hand
/// erfasst – es bucht sich nichts automatisch. Eine Umbuchung besteht aus zwei
/// gespiegelten Zeilen, die sich dieselbe transferId teilen.
model BookEntry {
  id              String         @id @default(cuid())
  accountId       String
  account         Account        @relation(fields: [accountId], references: [id])
  bookedAt        DateTime       @default(now())
  /// Positiv = Zugang, negativ = Abgang.
  amountCt        Int
  kind            String // INCOME | EXPENSE | TRANSFER
  category        String? // SALE | PURCHASE | FUN | OTHER
  /// Freitext, z.B. wer das Geld ausgegeben hat (gemeinsames Konto).
  note            String?
  transferId      String?
  settlementId    String?
  settlement      Settlement?    @relation(fields: [settlementId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([accountId, bookedAt])
  @@index([transferId])
  @@index([settlementId])
  @@index([purchaseOrderId])
}
