# Kopiere diese Datei nach .env.local (wird NICHT eingecheckt) und setze einen
# eigenen, langen Zufallswert. Er signiert das Session-Cookie der Login-Sperre.
#
# Wert erzeugen z.B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="BITTE_LANGEN_ZUFALLSWERT_EINTRAGEN"

# Auto-Sperre: Nach so vielen Minuten Inaktivität wird der Entschlüsselungs-Key
# aus dem Speicher entfernt und das Master-Passwort erneut verlangt.
# Standard 15. 0 = Auto-Sperre deaktiviert.
IDLE_TIMEOUT_MINUTES="15"

# --- Verkäufer-Portal (separate App, siehe portal-app/) ---
#
# Die Verkäufer reichen ihre Verkäufe über eine eigene, gehostete App ein
# (portal-app/, z.B. auf Vercel). Diese Haupt-App SYNCHRONISIERT mit ihr:
# offene Ware hochladen + Einreichungen abholen und verbuchen.

# Basis-URL der gehosteten Portal-App. Ohne diesen Wert ist der Sync deaktiviert.
PORTAL_BASE_URL="https://dein-portal.vercel.app"

# Gemeinsames Geheimnis für die Sync-Schnittstelle. MUSS in beiden Apps
# identisch sein. Erzeugen wie oben (randomBytes).
SYNC_SECRET="BITTE_LANGEN_ZUFALLSWERT_EINTRAGEN"

# Optional: alle Sync-Anfragen über einen Proxy leiten, damit der Hoster der
# Portal-App (Vercel) NICHT deine echte IP sieht. Leer lassen = direkt.
#   Tor (SOCKS5):   socks5://127.0.0.1:9050   (Tor-Dienst)  bzw. :9150 (Tor Browser)
#   HTTP-Proxy:     http://127.0.0.1:8118
# SYNC_PROXY_URL="socks5://127.0.0.1:9050"

# Eigener Schlüssel für den lokalen Portal-Speicher (portal.db) – hier liegen
# die Verkäufer-Zugänge (Token/PIN-Hash) und das Einreichungs-Protokoll.
# Fällt auf SESSION_SECRET zurück, wenn nicht gesetzt.
PORTAL_SECRET="BITTE_LANGEN_ZUFALLSWERT_EINTRAGEN"
