# Kopiere diese Datei nach .env.local (wird NICHT eingecheckt) und setze einen
# eigenen, langen Zufallswert. Er signiert das Session-Cookie der Login-Sperre.
#
# Wert erzeugen z.B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="BITTE_LANGEN_ZUFALLSWERT_EINTRAGEN"

# Auto-Sperre: Nach so vielen Minuten Inaktivität wird der Entschlüsselungs-Key
# aus dem Speicher entfernt und das Master-Passwort erneut verlangt.
# Standard 15. 0 = Auto-Sperre deaktiviert.
IDLE_TIMEOUT_MINUTES="15"

# Eigener Schlüssel für den Verkäufer-Portal-Eingang (portal.db). Damit sind die
# eingereichten Verkäufe verschlüsselt, OHNE vom Master-Passwort abzuhängen –
# so können Verkäufer auch bei gesperrter App einreichen.
# Fällt auf SESSION_SECRET zurück, wenn nicht gesetzt. Eigenen langen Zufallswert
# eintragen (gleiche Erzeugung wie oben).
PORTAL_SECRET="BITTE_LANGEN_ZUFALLSWERT_EINTRAGEN"
